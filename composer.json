{
    "name": "drupal/varbase_ai_chatbot_base",
    "description": "A visitor chatbot for Varbase 11 that answers only from the site's own content, with links to the pages it used. Reuses the vector index of Varbase AI Search. Experimental: AI Search has no stable release. No custom PHP or shell code.",
    "type": "drupal-recipe",
    "keywords": [
        "recipe",
        "Varbase recipes",
        "Drupal recipes",
        "Varbase AI",
        "Drupal AI",
        "AI Search",
        "RAG",
        "chatbot",
        "DeepChat",
        "AI Assistant"
    ],
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/Vardot/varbase_ai_chatbot_base",
    "authors": [
        {
            "name": "Vardot",
            "homepage": "https://www.vardot.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/Vardot/varbase_ai_chatbot_base/issues",
        "source": "https://github.com/Vardot/varbase_ai_chatbot_base"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "drupal/ai": "^1.5",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_search": "^1.3@alpha",
        "drupal/core": "^11.4",
        "drupal/search_api": "^1.40",
        "drupal/varbase_ai_search_base": "^1.0"
    }
}
